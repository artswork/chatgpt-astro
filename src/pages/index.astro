---
const projects = [
  {
    number: "01",
    title: "Studio North",
    type: "BRAND & WEB DESIGN",
    description: "An editorial, easy-to-navigate website for a creative studio.",
    tags: ["Art direction", "Astro"],
    accent: "#c9f36b",
    variant: "north",
  },
  {
    number: "02",
    title: "Pocket Budget",
    type: "PRODUCT CONCEPT",
    description: "A friendly concept that makes everyday money habits feel simpler.",
    tags: ["UX / UI", "Prototyping"],
    accent: "#f2b9a8",
    variant: "pocket",
  },
  {
    number: "03",
    title: "Field Notes",
    type: "DIGITAL EXPERIENCE",
    description: "A minimal home for stories, ideas, and things worth keeping.",
    tags: ["Web design", "Content"],
    accent: "#b9c7fb",
    variant: "field",
  },
  {
    number: "04",
    title: "Everyday Objects",
    type: "E-COMMERCE CONCEPT",
    description: "A warm, product-first storefront for thoughtful everyday goods.",
    tags: ["Frontend", "Responsive UI"],
    accent: "#f4db7b",
    variant: "objects",
  },
];

const skills = ["Astro", "HTML & CSS", "JavaScript", "Responsive design", "Accessibility", "Figma", "Git & GitHub", "Learning in public"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f1" />
    <meta
      name="description"
      content="The personal portfolio of Your Name — a designer and developer creating thoughtful digital experiences."
    />
    <title>Your Name — Designer & Developer</title>
  </head>
  <body>
    <div class="site-shell" id="top">
      <header class="topbar">
        <a class="brand" href="#top" aria-label="Your Name, home">
          <span class="brand-mark">Y.</span>
          <span class="brand-name">YOUR NAME</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href="#about">About</a>
          <a href="#skills">Skills</a>
          <a class="nav-cta" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> OPEN TO NEW OPPORTUNITIES</p>
            <h1 id="hero-title">Thoughtful digital<br /><span>experiences,</span><br />made with purpose.</h1>
            <p class="hero-lede">
              I'm Your Name — a designer and developer building clear, accessible, and memorable experiences for the web.
            </p>
            <div class="hero-actions">
              <a class="button-primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
              <a class="text-link" href="#about">A little about me <span aria-hidden="true">↘</span></a>
            </div>
            <div class="hero-meta">
              <div class="meta-item">
                <span class="meta-label">BASED IN</span>
                <strong>Seoul, South Korea</strong>
              </div>
              <div class="meta-item">
                <span class="meta-label">FOCUS</span>
                <strong>Design · Development</strong>
              </div>
            </div>
          </div>

          <div class="hero-art" aria-hidden="true">
            <div class="art-top"><span>PERSONAL PORTFOLIO</span><span>2026 / 01</span></div>
            <div class="art-sun"></div>
            <div class="art-orbit orbit-one"></div>
            <div class="art-orbit orbit-two"></div>
            <div class="art-disc"></div>
            <div class="art-sticker">IDEAS<br />INTO<br /><em>INTERFACES</em></div>
            <div class="art-bottom"><span>CURIOUS BY NATURE</span><span>SCROLL TO EXPLORE ↓</span></div>
          </div>
        </section>

        <div class="ticker" aria-hidden="true">
          <div>DESIGN WITH INTENTION <span>✳</span> BUILD WITH CARE <span>✳</span> ALWAYS LEARNING <span>✳</span> DESIGN WITH INTENTION <span>✳</span> BUILD WITH CARE <span>✳</span></div>
        </div>

        <section class="section work-section" id="work" aria-labelledby="work-title">
          <div class="section-head">
            <div>
              <p class="eyebrow">01 / SELECTED PROJECTS</p>
              <h2 id="work-title">A few things<br />I've made<span class="accent-dot">.</span></h2>
            </div>
            <p class="section-intro">A collection of concepts and practice projects that show how I think, design, and build.</p>
          </div>

          <div class="projects-grid">
            {projects.map((project) => (
              <article class={`project-card ${project.variant}`}>
                <div class="project-visual" style={`--project-accent: ${project.accent};`}>
                  <div class="project-window" aria-hidden="true"><i></i><i></i><i></i><span>PROJECT / {project.number}</span></div>
                  <div class="project-preview" aria-hidden="true">
                    <span class="preview-index">SELECTED WORK&nbsp; / &nbsp;{project.number}</span>
                    <div class="preview-shape"></div>
                    <span class="preview-label">{project.title}</span>
                  </div>
                </div>
                <div class="project-details">
                  <div>
                    <p class="project-type">{project.type}</p>
                    <h3>{project.title}</h3>
                    <p class="project-description">{project.description}</p>
                  </div>
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </div>
                <div class="tag-list">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </article>
            ))}
          </div>
          <p class="project-note">Starter content: replace these example projects, descriptions, and tags with your own work.</p>
        </section>

        <section class="about-section" id="about" aria-labelledby="about-title">
          <div class="section-marker">02 / ABOUT</div>
          <div class="about-content">
            <h2 id="about-title">Curious by nature.<br /><span>Intentional by design.</span></h2>
            <div class="about-columns">
              <p>I'm a creative problem-solver who enjoys turning complex ideas into clear, human-friendly digital experiences.</p>
              <p>I care about thoughtful details, accessible websites, and collaborating with people who care about what they make. I'm always learning and looking for the next interesting problem to solve.</p>
            </div>
            <a class="underlined-link" href="mailto:hello@example.com">More about me / Get in touch <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="section skills-section" id="skills" aria-labelledby="skills-title">
          <div class="section-head">
            <div>
              <p class="eyebrow">03 / THE TOOLKIT</p>
              <h2 id="skills-title">What I bring<span class="accent-dot">.</span></h2>
            </div>
            <p class="section-intro">Tools are part of the process. Clear thinking, curiosity, and good collaboration matter just as much.</p>
          </div>
          <div class="skill-cloud">
            {skills.map((skill, index) => (
              <span class="skill-pill"><span>{skill}</span><small>{String(index + 1).padStart(2, "0")}</small></span>
            ))}
          </div>
        </section>

        <section class="contact-section" id="contact" aria-labelledby="contact-title">
          <div class="contact-top">
            <p class="eyebrow"><span class="status-dot"></span> HAVE A PROJECT IN MIND?</p>
            <span class="section-marker">04 / CONTACT</span>
          </div>
          <div class="contact-content">
            <h2 id="contact-title">Let's make<br /><span>something meaningful.</span></h2>
            <p>Have an idea, a question, or just want to say hello? My inbox is open.</p>
            <a class="contact-link" href="mailto:hello@example.com">hello@example.com <span aria-hidden="true">↗</span></a>
          </div>
          <div class="contact-orb" aria-hidden="true"></div>
        </section>
      </main>

      <footer class="footer">
        <a class="brand" href="#top" aria-label="Your Name, back to top">
          <span class="brand-mark">Y.</span>
          <span class="brand-name">YOUR NAME</span>
        </a>
        <p class="footer-credit">Designed and built with Astro.</p>
        <div class="social-links">
          <a href="https://github.com/" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          <a href="mailto:hello@example.com">Email ↗</a>
        </div>
        <p class="copyright">© {new Date().getFullYear()} Your Name</p>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 88px; background: #f7f6f1; }
  :global(body) { margin: 0; color: #20211d; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 16px; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 3px solid #516d29; outline-offset: 5px; border-radius: 3px; }
  :global(::selection) { background: #c9f36b; color: #20211d; }

  .site-shell { max-width: 1600px; margin: 0 auto; padding: 0 6.1%; overflow: hidden; }
  .topbar { min-height: 88px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #deded5; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 800; letter-spacing: .12em; white-space: nowrap; }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #c9f36b; font-size: 16px; font-weight: 850; letter-spacing: -.08em; }
  .topbar nav { display: flex; align-items: center; gap: clamp(18px, 3.1vw, 44px); font-size: 12px; font-weight: 650; }
  .topbar nav a:not(.nav-cta) { color: #61625c; transition: color .2s ease; }
  .topbar nav a:hover { color: #20211d; }
  .nav-cta { display: inline-flex; align-items: center; gap: 18px; padding: 12px 15px; border: 1px solid #b8b9af; border-radius: 3px; }

  .hero { min-height: 650px; padding: 86px 0 78px; display: grid; grid-template-columns: 1.08fr .92fr; align-items: center; gap: 5%; }
  .eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 25px; font-size: 10px; line-height: 1.5; font-weight: 800; letter-spacing: .14em; }
  .status-dot { display: inline-block; width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: #7ba832; box-shadow: 0 0 0 4px rgba(123,168,50,.13); }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 720px; margin-bottom: 25px; font-size: clamp(48px, 6vw, 84px); line-height: .99; font-weight: 650; letter-spacing: -.075em; }
  h1 span, .about-content h2 span, .contact-content h2 span { color: #77796f; }
  .hero-lede { max-width: 425px; color: #65665e; font-size: 15px; line-height: 1.8; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 25px; margin-top: 32px; }
  .button-primary { display: inline-flex; align-items: center; gap: 35px; padding: 15px 17px; background: #20211d; color: #fff; border-radius: 3px; font-size: 12px; font-weight: 700; transition: transform .2s ease, background .2s ease; }
  .button-primary:hover { background: #3b3e32; transform: translateY(-2px); }
  .text-link { display: inline-flex; gap: 13px; align-items: center; font-size: 12px; font-weight: 700; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 42px; margin-top: 60px; }
  .meta-item { display: grid; gap: 8px; }
  .meta-label { color: #85867d; font-size: 9px; font-weight: 800; letter-spacing: .14em; }
  .meta-item strong { font-size: 11px; font-weight: 650; }

  .hero-art { position: relative; min-height: 435px; aspect-ratio: .96; overflow: hidden; background: #dce8cd; border-radius: 3px; isolation: isolate; }
  .art-top, .art-bottom { position: absolute; z-index: 5; left: 22px; right: 22px; display: flex; justify-content: space-between; gap: 14px; color: #30392a; font-size: 8px; letter-spacing: .12em; font-weight: 800; }
  .art-top { top: 20px; }
  .art-bottom { bottom: 20px; }
  .art-sun { position: absolute; width: 42%; aspect-ratio: 1; top: 17%; left: 27%; border-radius: 50%; background: #c9f36b; }
  .art-orbit { position: absolute; z-index: 2; border: 1px solid rgba(32,33,29,.48); border-radius: 50%; transform: rotate(-35deg); }
  .orbit-one { width: 108%; height: 45%; top: 30%; left: -4%; }
  .orbit-two { width: 105%; height: 61%; top: 22%; left: -2%; transform: rotate(52deg); }
  .art-disc { position: absolute; z-index: 3; width: 38%; aspect-ratio: 1; right: 13%; bottom: 17%; border-radius: 50%; background: #272a23; box-shadow: inset -17px -14px 0 rgba(255,255,255,.08); }
  .art-sticker { position: absolute; z-index: 4; left: 10%; top: 42%; padding: 13px 14px; background: #f7f6f1; color: #20211d; font-size: clamp(14px, 1.5vw, 20px); line-height: .98; letter-spacing: -.06em; font-weight: 900; transform: rotate(-8deg); box-shadow: 4px 5px 0 rgba(32,33,29,.13); }
  .art-sticker em { color: #6b8d35; font-style: normal; }

  .ticker { width: calc(100% + 14%); margin-left: -7%; overflow: hidden; padding: 17px 0; background: #c9f36b; transform: rotate(-1.3deg); }
  .ticker div { width: max-content; display: flex; align-items: center; gap: 27px; white-space: nowrap; font-size: 11px; font-weight: 850; letter-spacing: .12em; animation: drift 32s linear infinite; }
  .ticker span { font-size: 17px; }
  @keyframes drift { to { transform: translateX(-25%); } }

  .section { padding: 125px 0; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 36px; margin-bottom: 48px; }
  .section-head .eyebrow { margin-bottom: 20px; }
  h2 { margin-bottom: 0; font-size: clamp(38px, 4.7vw, 64px); line-height: 1.03; letter-spacing: -.07em; font-weight: 650; }
  .accent-dot { color: #7ba832; }
  .section-intro { max-width: 305px; margin-bottom: 5px; color: #74756d; font-size: 13px; line-height: 1.8; }
  .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 22px; }
  .project-card { min-width: 0; }
  .project-visual { position: relative; aspect-ratio: 1.43; overflow: hidden; background: var(--project-accent); }
  .project-window { position: absolute; z-index: 2; top: 14px; left: 15px; right: 15px; display: flex; align-items: center; gap: 5px; color: rgba(32,33,29,.7); }
  .project-window i { display: block; width: 5px; height: 5px; border-radius: 50%; background: rgba(32,33,29,.5); }
  .project-window span { margin-left: auto; font-size: 7px; font-weight: 800; letter-spacing: .11em; }
  .project-preview { position: absolute; inset: 43px 9% 8%; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 17px; border: 1px solid rgba(32,33,29,.13); border-radius: 3px; background: rgba(250,249,244,.84); box-shadow: 0 8px 25px rgba(32,33,29,.08); }
  .preview-index { position: relative; z-index: 2; font-size: 7px; font-weight: 850; letter-spacing: .1em; }
  .preview-shape { position: absolute; width: 39%; aspect-ratio: 1; top: 22%; left: 30%; border-radius: 50%; background: #20211d; }
  .preview-label { position: relative; z-index: 2; font-size: clamp(18px, 2.6vw, 32px); font-weight: 750; letter-spacing: -.075em; }
  .north .preview-shape { left: 34%; top: 19%; width: 36%; background: #c9f36b; border: 14px solid #20211d; box-shadow: 27px 20px 0 -3px #d4dfc2; }
  .pocket .preview-shape { width: 68%; height: 45%; top: 24%; left: 16%; aspect-ratio: auto; border-radius: 48% 48% 10px 10px; background: #f2b9a8; border: 1px solid #20211d; transform: rotate(-8deg); }
  .field .preview-shape { width: 70%; height: 38%; top: 25%; left: 15%; aspect-ratio: auto; border-radius: 2px; background: repeating-linear-gradient(135deg, #b9c7fb 0 8px, #20211d 8px 9px); transform: rotate(5deg); }
  .objects .preview-shape { width: 39%; top: 18%; left: 32%; background: #f4db7b; border-radius: 22% 22% 48% 48%; border: 1px solid #20211d; transform: rotate(13deg); box-shadow: -26px 20px 0 -7px #e9a78b, 27px 24px 0 -8px #94a879; }
  .project-details { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding-top: 20px; }
  .project-type { margin-bottom: 9px; color: #85867d; font-size: 9px; font-weight: 850; letter-spacing: .13em; }
  .project-details h3 { margin-bottom: 8px; font-size: 23px; letter-spacing: -.055em; font-weight: 700; }
  .project-description { max-width: 360px; margin-bottom: 0; color: #74756d; font-size: 12px; line-height: 1.7; }
  .project-arrow { display: grid; flex: 0 0 34px; place-items: center; width: 34px; height: 34px; border: 1px solid #d5d5cc; border-radius: 50%; font-size: 15px; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 17px; }
  .tag-list span { padding: 6px 9px; border: 1px solid #deded5; border-radius: 2px; color: #61625c; font-size: 9px; }
  .project-note { margin: 26px 0 0; color: #8a8b83; font-size: 10px; line-height: 1.6; }

  .about-section { display: grid; grid-template-columns: .32fr 1fr; gap: 7%; padding: 78px 0 95px; border-top: 1px solid #deded5; border-bottom: 1px solid #deded5; }
  .section-marker { color: #85867d; font-size: 9px; font-weight: 850; letter-spacing: .14em; white-space: nowrap; }
  .about-content h2 { margin: -8px 0 35px; }
  .about-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 35px; max-width: 730px; }
  .about-columns p { margin: 0; color: #696a62; font-size: 13px; line-height: 1.9; }
  .underlined-link { display: inline-flex; align-items: center; gap: 15px; margin-top: 30px; padding-bottom: 8px; border-bottom: 1px solid #85867d; font-size: 11px; font-weight: 750; }
  .skills-section { padding-bottom: 130px; }
  .skill-cloud { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); border-top: 1px solid #d9d9d0; border-left: 1px solid #d9d9d0; }
  .skill-pill { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 19px; border-right: 1px solid #d9d9d0; border-bottom: 1px solid #d9d9d0; font-size: 12px; font-weight: 650; }
  .skill-pill small { color: #96978f; font-size: 8px; font-weight: 750; }

  .contact-section { position: relative; overflow: hidden; min-height: 440px; padding: 38px 40px 50px; background: #20211d; color: #f7f6f1; }
  .contact-top { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .contact-top .eyebrow { margin-bottom: 0; }
  .contact-top .section-marker { color: #a7a89e; }
  .contact-content { position: relative; z-index: 2; max-width: 780px; margin-top: 64px; }
  .contact-content h2 { font-size: clamp(43px, 6.2vw, 81px); }
  .contact-content h2 span { color: #c9f36b; }
  .contact-content > p { max-width: 390px; margin: 24px 0 23px; color: #c1c2b9; font-size: 12px; line-height: 1.8; }
  .contact-link { display: inline-flex; align-items: center; gap: 28px; padding-bottom: 8px; border-bottom: 1px solid #82847a; font-size: 14px; font-weight: 650; }
  .contact-orb { position: absolute; width: 330px; height: 330px; right: -40px; bottom: -140px; border: 1px solid rgba(201,243,107,.55); border-radius: 50%; box-shadow: 0 0 0 26px rgba(201,243,107,.04), 0 0 0 52px rgba(201,243,107,.04), 0 0 0 78px rgba(201,243,107,.04); }
  .footer { min-height: 105px; display: grid; grid-template-columns: 1fr 1fr auto auto; align-items: center; gap: 22px; padding: 25px 0; }
  .footer-credit, .copyright { margin: 0; color: #818279; font-size: 10px; }
  .social-links { display: flex; flex-wrap: wrap; gap: 17px; font-size: 10px; font-weight: 650; }
  .social-links a:hover, .underlined-link:hover, .contact-link:hover { color: #7ba832; }

  @media (min-width: 1350px) { .hero { min-height: 720px; } }
  @media (max-width: 900px) {
    .site-shell { padding: 0 5%; }
    .hero { min-height: 0; padding: 70px 0; grid-template-columns: 1fr  .8fr; gap: 4%; }
    .hero-meta { margin-top: 42px; gap: 25px; }
    .hero-art { min-height: 340px; }
    .art-top, .art-bottom { left: 13px; right: 13px; font-size: 7px; }
    .art-sticker { font-size: 14px; }
    .section { padding: 95px 0; }
    .about-section { grid-template-columns: .22fr 1fr; gap: 5%; }
    .skill-pill { padding: 14px; }
    .footer { grid-template-columns: 1fr 1fr; }
    .social-links { justify-content: flex-end; }
    .copyright { text-align: right; }
  }
  @media (max-width: 640px) {
    :global(html) { scroll-padding-top: 65px; }
    .site-shell { padding: 0 20px; }
    .topbar { min-height: 70px; align-items: center; }
    .brand { gap: 7px; font-size: 9px; }
    .brand-mark { width: 30px; height: 30px; }
    .topbar nav { gap: 14px; font-size: 10px; }
    .topbar nav a:nth-child(2), .topbar nav a:nth-child(3) { display: none; }
    .nav-cta { gap: 8px; padding: 10px; }
    .hero { grid-template-columns: 1fr; padding: 62px 0 55px; gap: 42px; }
    .eyebrow { margin-bottom: 20px; font-size: 9px; }
    h1 { font-size: clamp(48px, 12vw, 69px); }
    .hero-lede { font-size: 13px; }
    .hero-meta { margin-top: 40px; gap: 28px; }
    .hero-art { width: 100%; min-height: 0; aspect-ratio: 1.08; }
    .art-sticker { font-size: 19px; }
    .ticker { margin-top: 0; padding: 14px 0; }
    .section { padding: 78px 0; }
    .section-head { display: block; margin-bottom: 32px; }
    .section-intro { margin-top: 22px; max-width: 360px; }
    h2 { font-size: 47px; }
    .projects-grid { grid-template-columns: 1fr; gap: 35px; }
    .project-visual { aspect-ratio: 1.28; }
    .preview-label { font-size: 29px; }
    .project-details h3 { font-size: 22px; }
    .about-section { display: block; padding: 55px 0 65px; }
    .about-content { margin-top: 36px; }
    .about-content h2 { margin-bottom: 27px; font-size: 41px; }
    .about-columns { grid-template-columns: 1fr; gap: 14px; }
    .skills-section { padding-bottom: 80px; }
    .skill-cloud { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .skill-pill { min-height: 66px; padding: 14px 12px; font-size: 11px; }
    .contact-section { min-height: 430px; padding: 25px 22px 35px; margin: 0 -2px; }
    .contact-top .eyebrow { max-width: 190px; font-size: 8px; }
    .contact-top .section-marker { font-size: 8px; }
    .contact-content { margin-top: 75px; }
